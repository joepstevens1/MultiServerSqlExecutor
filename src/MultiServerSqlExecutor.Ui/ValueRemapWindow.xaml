<Window x:Class="MultiServerSqlExecutor.Ui.ValueRemapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remap Value"
        Height="225"
        Width="470"
        MinHeight="225"
        MinWidth="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtMessage"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <TextBlock Grid.Row="1"
                   Text="Import value:"
                   Margin="0,0,0,4" />
        <TextBox x:Name="TxtSourceValue"
                 Grid.Row="2"
                 IsReadOnly="True"
                 Margin="0,0,0,10" />

        <StackPanel Grid.Row="3">
            <TextBlock Text="Save in settings as:"
                       Margin="0,0,0,4" />
            <TextBox x:Name="TxtTargetValue" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK"
                    IsDefault="True"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Click="OnOk" />
            <Button Content="Cancel"
                    IsCancel="True"
                    MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
