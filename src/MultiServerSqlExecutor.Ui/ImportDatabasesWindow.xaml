<Window x:Class="MultiServerSqlExecutor.Ui.ImportDatabasesWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Databases" Height="760" Width="1180" MinWidth="980" MinHeight="660" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="CSV File:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="TxtCsvPath" Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Browse..." Click="OnBrowseCsv" MinWidth="90" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Preview Import" Click="OnPreviewImport" MinWidth="110" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <GroupBox Header="Field Mappings" Margin="0,0,0,10">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Choose where each server setting comes from: a CSV column, a fixed value, or the current saved value."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <DataGrid x:Name="FieldMappingsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionChanged="OnFieldMappingSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Target Field" Binding="{Binding DisplayName}" IsReadOnly="True" Width="140" />
                                <DataGridTemplateColumn Header="Source" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceMode}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.SourceModes, ElementName=RootWindow}"
                                                      SelectedItem="{Binding SourceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CSV Column" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceColumn}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableColumns, ElementName=RootWindow}"
                                                      SelectedItem="{Binding SourceColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Fixed Value" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock x:Name="FixedValueText" Text="{Binding FixedValue}" VerticalAlignment="Center" />
                                                <ComboBox x:Name="FixedValueAuthCombo"
                                                          ItemsSource="{Binding DataContext.AuthenticationOptions, ElementName=RootWindow}"
                                                          SelectedItem="{Binding FixedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="Collapsed" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthenticationField}" Value="True">
                                                    <Setter TargetName="FixedValueText" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="FixedValueAuthCombo" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBox x:Name="FixedValueTextEditor" Text="{Binding FixedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ComboBox x:Name="FixedValueAuthComboEditor"
                                                          ItemsSource="{Binding DataContext.AuthenticationOptions, ElementName=RootWindow}"
                                                          SelectedItem="{Binding FixedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="Collapsed" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthenticationField}" Value="True">
                                                    <Setter TargetName="FixedValueTextEditor" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="FixedValueAuthComboEditor" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Group Mappings" Margin="0,0,0,10">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add Group Mapping" Click="OnAddGroupMapping" MinWidth="130" Margin="0,0,8,0" />
                            <Button Content="Remove Selected" Click="OnRemoveGroupMapping" MinWidth="120" />
                        </StackPanel>
                        <DataGrid x:Name="GroupMappingsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionChanged="OnGroupMappingSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mapping" Binding="{Binding DisplayName}" IsReadOnly="True" Width="90" />
                                <DataGridTemplateColumn Header="Source" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceMode}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.SourceModes, ElementName=RootWindow}"
                                                      SelectedItem="{Binding SourceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CSV Column" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceColumn}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableColumns, ElementName=RootWindow}"
                                                      SelectedItem="{Binding SourceColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Fixed Value" Binding="{Binding FixedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Value Remaps">
                    <DockPanel Margin="8">
                        <TextBlock x:Name="TxtValueRemapContext"
                                   DockPanel.Dock="Top"
                                   Text="Select a field mapping or group mapping to edit value remaps."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add Remap" Click="OnAddValueRemap" MinWidth="100" Margin="0,0,8,0" />
                            <Button Content="Remove Selected" Click="OnRemoveValueRemap" MinWidth="120" />
                        </StackPanel>
                        <DataGrid x:Name="ValueMappingsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source Value" Binding="{Binding SourceValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Target Value" Binding="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <GroupBox Header="Preview Summary" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <TextBlock x:Name="TxtSummary" Text="Choose a CSV file, review the mappings, then preview the import." TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Databases To Add Or Update" Margin="0,0,0,10">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="Preview of the entries that will be written into the saved database list." TextWrapping="Wrap" />
                        <DataGrid x:Name="PreviewGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionUnit="CellOrRowHeader"
                                  PreviewMouseRightButtonDown="OnPreviewGridRightMouseButtonDown"
                                  PreviewKeyDown="OnPreviewGridPreviewKeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy Value"
                                              Click="OnPreviewCellCopy" />
                                    <Separator />
                                    <MenuItem Header="Remap This Value..."
                                              Click="OnPreviewCellRemap" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="2*" />
                                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="2*" />
                                <DataGridTextColumn Header="Auth" Binding="{Binding Authentication}" Width="120" />
                                <DataGridTextColumn Header="Groups" Binding="{Binding Groups}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Databases Missing From Import">
                    <DockPanel Margin="8">
                        <CheckBox x:Name="ChkEnableRemovals"
                                  DockPanel.Dock="Top"
                                  Content="Remove selected saved databases that are not in this import"
                                  Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Pick only the ones you want removed."
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap" />
                        <DataGrid x:Name="RemovalsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Remove" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="2*" />
                                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Import" Click="OnImport" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="Cancel" Click="OnCancel" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
